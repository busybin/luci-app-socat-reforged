#!/bin/sh /etc/rc.common
# procd service for the socat-reforged forwarding engine.
#
# This is the app's own service (name "socat-reforged") so it never collides
# with an unrelated /etc/init.d/socat shipped by a socat build. The engine
# reconciles /etc/config/socat against the running workers on every cycle.
USE_PROCD=1
START=99
STOP=10

start_service() {
	procd_open_instance
	procd_set_param command /bin/sh /etc/socat-boot.sh
	# Never give up respawning: a forwarding engine that is left dead means the
	# forwards silently stop working.  The third value is max_fail, kept
	# effectively unlimited on purpose.
	procd_set_param respawn 3600 5 999999
	# Route the engine's own stderr to syslog.  Without this a shell-level
	# failure (e.g. "can't fork") is lost in /dev/null and the engine just
	# disappears between two "engine started" lines.
	procd_set_param stderr 1
	# procd gives a process 5 s by default, then SIGKILLs it.  The engine's
	# loop sleeps 15 s between cycles; `nap` (see socat-boot.sh) keeps that
	# sleep interruptible so the trap runs at once, and this is the backstop for
	# a cycle that happens to be busy (a reconcile against many rules).  Being
	# killed would skip the trap: no "caught SIGTERM" line, no runtime cleanup.
	procd_set_param term_timeout 20
	procd_close_instance
}

stop_service() {
	# The engine only kills the workers it started itself (they carry a
	# SOCAT_REFORGED=1 marker), so somebody else's socat is never touched.
	/etc/socat-boot.sh cleanup >/dev/null 2>&1
}
