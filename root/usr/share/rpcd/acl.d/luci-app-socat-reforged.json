{
	"luci-app-socat-reforged": {
		"description": "Grant access to Socat Reforged (custom UCI socat forwarding page)",
		"read": {
			"ubus": {
				"luci.socat-reforged": [ "status", "peers", "rule_log", "migrate_scan", "port_owners", "log", "update_check", "update_status" ]
			},
			"uci": [ "socat" ]
		},
		"write": {
			"ubus": {
				"luci.socat-reforged": [ "start", "stop", "restart", "reload", "rule_restart", "rule_pause", "rule_resume", "log_clear", "test" ]
			},
			"uci": [ "socat" ]
		}
	}
}
