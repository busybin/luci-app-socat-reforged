#!/bin/sh
# ============================================================================
# socat-reforged-update — download the release files given as arguments,
# verify them against the release's sha256sums and install them.
# ============================================================================
# Started *detached* by the LuCI backend (rpcd): the postinst of the freshly
# installed package restarts rpcd, which would kill the ubus call that started
# this job, so the progress has to go somewhere the page can poll:
#
#   /var/run/socat-reforged/update.state  one line: running <pid>
#                                                | ok <version>
#                                                | fail <reason>
#   /var/run/socat-reforged/update.log    whatever the downloader and the
#                                         package manager printed
#
# Usage: socat-reforged-update <sha256sums-url> <url> [<url> ...]
#   The first argument is the release's checksum file; every other file is
#   verified against it before it reaches the package manager.  The app
#   package must be passed first: the Chinese language package depends on it.
set -u

STATE_DIR=/var/run/socat-reforged
STATE=$STATE_DIR/update.state
LOG=$STATE_DIR/update.log
VERF=/usr/libexec/socat-reforged-version
UA='luci-app-socat-reforged'
WORK=""

umask 077
mkdir -p "$STATE_DIR" 2>/dev/null || exit 1
chmod 700 "$STATE_DIR" 2>/dev/null

cleanup() { [ -n "$WORK" ] && rm -rf "$WORK"; }
trap cleanup EXIT INT TERM

: > "$LOG"
printf 'running %s\n' "$$" > "$STATE"

log() { printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$LOG"; }
die() { log "FAIL: $*"; printf 'fail %s\n' "$*" > "$STATE"; exit 1; }

[ $# -ge 2 ] || die 'usage: socat-reforged-update <sha256sums-url> <url> [<url> ...]'
SUMS_URL=$1
shift

WORK=$(mktemp -d "$STATE_DIR/update.XXXXXX") || die "cannot create a work directory in $STATE_DIR"
SUMS=$WORK/sha256sums

# One of these exists on every OpenWrt (uclient-fetch is what /usr/bin/wget is
# here).  Certificate verification is deliberately left ON: whatever arrives
# here is installed as root afterwards.
fetch() { # fetch <url> <out>
	if command -v uclient-fetch >/dev/null 2>&1; then
		uclient-fetch -q -T 30 -U "$UA" -O "$2" "$1" >> "$LOG" 2>&1 && [ -s "$2" ] && return 0
	fi
	if command -v curl >/dev/null 2>&1; then
		curl -fsSL --proto-redir =https --connect-timeout 30 -m 300 -A "$UA" -o "$2" "$1" >> "$LOG" 2>&1 && [ -s "$2" ] && return 0
	fi
	if command -v wget >/dev/null 2>&1; then
		wget -q -T 30 -U "$UA" -O "$2" "$1" >> "$LOG" 2>&1 && [ -s "$2" ] && return 0
	fi
	rm -f "$2"
	return 1
}

command -v sha256sum >/dev/null 2>&1 || die 'sha256sum is not available'
log "downloading the checksum file"
fetch "$SUMS_URL" "$SUMS" || die 'checksum file download failed'

FILES=""
for url in "$@"; do
	name=${url##*/}
	case "$name" in
		*.apk|*.ipk) ;;
		*) die "unexpected file type: $name" ;;
	esac
	# The name becomes a file name plus a key in the checksum file: no
	# slashes, spaces or dots that could be read as a path.
	case "$name" in
		*[!A-Za-z0-9._-]*) die "unexpected file name: $name" ;;
	esac
	[ -e "$WORK/$name" ] && die "duplicate file: $name"
	log "downloading $name"
	fetch "$url" "$WORK/$name" || die "download failed: $name"
	want=$(awk -v n="$name" '$2 == n || $2 == "*" n { print $1; exit }' "$SUMS")
	[ -n "$want" ] || die "the checksum file has no entry for $name"
	got=$(sha256sum "$WORK/$name" | awk '{ print $1 }')
	[ "$got" = "$want" ] || die "checksum mismatch: $name"
	log "verified $name ($(wc -c < "$WORK/$name") bytes)"
	FILES="$FILES $WORK/$name"
done

# The postinst that runs at the end restarts procd, rpcd and the engine, so the
# session that called us dies long before this script does -- everything the
# package manager prints goes to the log instead of to that dead pipe.
if command -v apk >/dev/null 2>&1; then
	for f in $FILES; do
		case "$f" in *.apk) ;; *) continue ;; esac
		log "installing ${f##*/}"
		apk add --allow-untrusted "$f" >> "$LOG" 2>&1 || die "package installation failed: ${f##*/}"
	done
elif command -v opkg >/dev/null 2>&1; then
	for f in $FILES; do
		case "$f" in *.ipk) ;; *) continue ;; esac
		log "installing ${f##*/}"
		if ! opkg install "$f" >> "$LOG" 2>&1; then
			log "opkg refused it, retrying with --force-reinstall"
			opkg install --force-reinstall "$f" >> "$LOG" 2>&1 || die "package installation failed: ${f##*/}"
		fi
	done
else
	die 'no package manager (apk or opkg) found'
fi

V=$(sed -n 's/^PKG_VERSION=//p' "$VERF" 2>/dev/null | head -1)
log "done${V:+ (installed $V)}"
printf 'ok %s\n' "${V:-unknown}" > "$STATE"
exit 0
