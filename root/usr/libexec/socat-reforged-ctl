#!/bin/sh
# socat-reforged-ctl — start/stop/restart the socat forward engine.
#
# The engine runs as the procd service "socat-reforged".  We prefer our own
# init; if it is missing we fall back to a legacy "socat" init (e.g. from a
# custom socat build) so the buttons keep working during a migration.
#
#  start   : (re-)register and start the procd service
#  stop    : unregister the service (procd would otherwise respawn the loop
#            and its workers), then let the engine clean up: it only ever
#            kills the workers it started itself.
#  restart : a full service restart (stop + start)
SERVICE=socat-reforged
[ -x /etc/init.d/socat-reforged ] || SERVICE=socat

case "$1" in
	start)
		/etc/init.d/$SERVICE start >/dev/null 2>&1
		;;
	stop)
		ubus call service delete '{"name":"'"$SERVICE"'"}' >/dev/null 2>&1
		for p in $(pgrep -f '/etc/socat-boot.sh$' 2>/dev/null); do
			kill -9 "$p" 2>/dev/null
		done
		/etc/socat-boot.sh cleanup >/dev/null 2>&1
		;;
	restart)
		/etc/init.d/$SERVICE restart >/dev/null 2>&1
		;;
	status)
		/etc/socat-boot.sh status
		;;
	*)
		echo "usage: $0 start|stop|restart|status" >&2
		exit 1
		;;
esac
exit 0
