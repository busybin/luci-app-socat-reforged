#!/bin/sh
# Take the packaged copies apk/opkg park as <file>.apk-new beside an /etc file
# they refuse to overwrite; the postinst runs this before starting the engine.
# Usage: socat-reforged-apply-deferred [<root>]  (root for tests)
# Exit: 0 = applied (or nothing to do), 1 = something could not be applied.
set -u

ROOT=${1:-}

# every installed file except the version stamp the postinst generates
FILES='
etc/socat-boot.sh
etc/init.d/socat-reforged
etc/hotplug.d/iface/99-socat-reforged
usr/libexec/socat-reforged-apply-deferred
usr/libexec/socat-reforged-ctl
usr/libexec/socat-reforged-gen.awk
usr/libexec/socat-reforged-reload
usr/libexec/socat-reforged-update
usr/libexec/socat-reforged-zones.awk
usr/share/luci/menu.d/luci-app-socat-reforged.json
usr/share/rpcd/acl.d/luci-app-socat-reforged.json
usr/share/rpcd/ucode/luci.socat-reforged.uc
usr/share/ucitrack/luci-app-socat-reforged.json
www/luci-static/resources/view/network/socat-reforged.js
'

failed=0
for rel in $FILES; do
	f="$ROOT/$rel"
	for suffix in apk-new opkg-new; do
		[ -f "$f.$suffix" ] || continue
		if mv -f "$f.$suffix" "$f"; then
			echo "applied the packaged copy of $f ($suffix)"
		else
			echo "WARNING: could not apply $f.$suffix" >&2
			failed=1
		fi
	done
done

[ "$failed" -eq 0 ]
